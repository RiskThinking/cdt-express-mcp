{
  "manifest_version": "0.3",
  "name": "cdt-express.mcpb",
  "display_name": "CDT Express by Riskthinking.AI",
  "description": "Physical climate risk metrics for locations, assets, companies, and market indexes from CDT Express",
  "author": {
    "name": "Riskthinking.AI",
    "url": "https://riskthinking.ai"
  },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "build/index.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/build/index.mjs"
      ],
      "env": {
        "CDT_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "CDT Express API Key",
      "description": "Obtain at https://velo.riskthinking.ai/cdt-express",
      "required": true,
      "sensitive": true
    }
  },
  "version": "0.8.0",
  "homepage": "https://velo.riskthinking.ai/cdt-express",
  "documentation": "https://github.com/RiskThinking/cdt-express-mcp#readme",
  "support": "https://github.com/RiskThinking/cdt-express-mcp/issues",
  "privacy_policies": [
    "https://riskthinking.ai/privacy-policy"
  ]
}
