{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RiskThinking/cdt-express-mcp",
  "description": "Interact with climate metrics via Riskthinking.AI's CDT Express API in supported AI chat experiences",
  "repository": {
    "url": "https://github.com/RiskThinking/cdt-express-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "transportType": "streamable-http",
      "url": "https://mcp.riskthinking.ai/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "mcpb",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
