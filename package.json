{
  "name": "@riskthinking.ai/cdt-express-mcp",
  "version": "0.6.0",
  "description": "Interact with climate metrics via Riskthinking.AI's CDT Express API in supported AI chat experiences",
  "type": "module",
  "main": "index.js",
  "mcpName": "io.github.RiskThinking/cdt-express-mcp",
  "scripts": {
    "build": "tsc",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "check:version": "node scripts/sync-version.mjs --check",
    "start:http": "node build/http.js",
    "dev:http": "npm run build && node --env-file-if-exists=.env build/http.js",
    "smoke": "node scripts/smoke-mcp.mjs",
    "pack": "npm run build:mcpb",
    "sync:version": "node scripts/sync-version.mjs",
    "test": "npm run check:version && npm run build && node --test test/*.test.js",
    "version": "npm run sync:version"
  },
  "keywords": [
    "mcp",
    "CDT Express",
    "Riskthinking.AI",
    "climate",
    "metrics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/riskthinking-ai/cdt-express-mcp"
  },
  "author": {
    "name": "Riskthinking.AI",
    "url": "https://riskthinking.ai"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "ipaddr.js": "^1.9.1",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
