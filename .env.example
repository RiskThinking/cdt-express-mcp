PORT=3000
HOST=0.0.0.0
MCP_PUBLIC_BASE_URL=https://mcp.riskthinking.ai
# Additional comma-separated hostnames, such as the service's default run.app host.
MCP_ALLOWED_HOSTS=
# Number of trusted reverse-proxy hops. Cloud Run uses one hop in this deployment.
MCP_TRUST_PROXY_HOPS=1
MCP_OAUTH_SECRET=replace-with-at-least-32-random-characters
VELO_AUTHORIZE_URL=https://velo.riskthinking.ai/mcp/authorize
# Optional comma-separated browser origins. Requests without Origin are allowed.
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai,https://gemini.google.com
# Accept any HTTPS Client ID Metadata Document that resolves only to public IPs.
# Replace * with a comma-separated origin allowlist for a closed deployment.
MCP_ALLOWED_CIMD_ORIGINS=*
